# Copy this file to .streamlit/secrets.toml and fill in real values.
# NEVER commit .streamlit/secrets.toml.

# ──────────────────────────────────────────────────────────────
# Flight Schedule Pro API
# ──────────────────────────────────────────────────────────────
FSP_API_KEY = "your-primary-key-here"
FSP_OPERATOR_ID = "12345"           # numeric operator ID

# Optional FSP endpoint overrides (defaults shown)
# FSP_BASE_URL              = "https://usc-api.flightschedulepro.com/core/v1.0"
# FSP_SCHEDULING_BASE_URL   = "https://usc-api.flightschedulepro.com/scheduling/v1.0"
# FSP_REPORTS_BASE_URL      = "https://usc-api.flightschedulepro.com/reports/v1.0"

# ──────────────────────────────────────────────────────────────
# Google Sheets — where dispatch submissions are appended
# Required for production. Leave GOOGLE_SHEET_ID blank for local-only
# development (submissions go to SQLite instead).
# ──────────────────────────────────────────────────────────────
GOOGLE_SHEET_ID = ""                # the ?id= portion of the Sheet URL
GOOGLE_SHEET_WORKSHEET = "Dispatches"

# Google service-account credentials for writing to the Sheet.
# Paste the JSON values from your downloaded service-account key file.
# Required when GOOGLE_SHEET_ID is set.
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "..."

# ──────────────────────────────────────────────────────────────
# Streamlit native Google OAuth (st.login)
# Required for production. Without these, the app runs anonymously
# (anyone can fill out the form; useful for local dev).
# ──────────────────────────────────────────────────────────────
# [auth]
# redirect_uri = "http://localhost:8502/oauth2callback"   # use https://<app>.streamlit.app/oauth2callback in prod
# cookie_secret = "generate-a-long-random-string-for-this-key"
# client_id = "1234567890-abc.apps.googleusercontent.com"
# client_secret = "GOCSPX-..."
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ──────────────────────────────────────────────────────────────
# Branding overrides (defaults shown)
# ──────────────────────────────────────────────────────────────
# COMPANY_NAME = "Elevation Aviation"
# DISPATCH_TITLE = "Dispatch"
# DISPATCH_SUBTITLE = "Complete Elevation Aviation dispatch from prior to each flight"
